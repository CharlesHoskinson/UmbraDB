{
  "name": "umbradb",
  "version": "0.9.5",
  "description": "A local, single-writer, PostgreSQL-backed temporal and content-addressed store for Midnight wallet state.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesHoskinson/UmbraDB.git"
  },
  "homepage": "https://github.com/CharlesHoskinson/UmbraDB#readme",
  "bugs": {
    "url": "https://github.com/CharlesHoskinson/UmbraDB/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "docs:storage": "typedoc",
    "docs:storage:check": "typedoc --emit none --treatWarningsAsErrors",
    "test": "vitest run",
    "test:conformance": "node scripts/conformance-gate.mjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:ci": "node scripts/mutation-per-adapter.mjs",
    "test:live": "UMBRADB_LIVE_PREPROD=1 vitest run test/integration/preprod-db-sync.integration.test.ts test/integration/cold-boot-recovery.integration.test.ts",
    "test:smoke": "npm run build && node test/smoke/pack-install.mjs",
    "archive:sync": "tsx chain-archive-sync/sync-cli.ts",
    "bench": "tsx bench/harness.ts",
    "bench:smoke": "tsx bench/smoke.ts"
  },
  "dependencies": {
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-canary.20260716150734-e744d99",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "effect": "3.22.0",
    "fast-check": "^4.9.0",
    "tinybench": "^2.9.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
